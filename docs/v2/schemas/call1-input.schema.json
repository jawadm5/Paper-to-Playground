{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-to-playground:v2.1:call1-input",
  "title": "Call1Context",
  "description": "The text context for call 1. Attach actual labeled images separately; do not send asset paths as substitutes for image bytes.",
  "type": "object",
  "properties": {
    "focus": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceBlock"
      }
    },
    "visuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VisualEvidence"
      }
    },
    "extraction_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "required": [
    "focus",
    "audience",
    "source_blocks",
    "visuals",
    "extraction_warnings"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "source_blocks": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "visuals": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "Locator": {
      "type": "object",
      "properties": {
        "section": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "equation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "figure": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "section",
        "page",
        "equation",
        "figure"
      ],
      "additionalProperties": false
    },
    "SourceBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "heading",
            "paragraph",
            "equation",
            "table",
            "caption",
            "page"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "locator"
      ],
      "additionalProperties": false
    },
    "VisualEvidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "figure",
            "page_image"
          ]
        },
        "caption": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "provided_as": {
          "type": "string",
          "enum": [
            "image_and_caption",
            "image_only",
            "caption_only"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "caption",
        "locator",
        "provided_as"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provided_as": {
                "const": "image_only"
              }
            }
          },
          "then": {
            "properties": {
              "caption": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provided_as": {
                "enum": [
                  "image_and_caption",
                  "caption_only"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "caption": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "page_image"
              }
            }
          },
          "then": {
            "properties": {
              "locator": {
                "properties": {
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Code-generated record of evidence actually supplied; the matching image is a separate labeled content part."
    }
  }
}
