{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research lab experience: declarative Call 2 output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "introduction",
    "no_experiments_reason",
    "sections",
    "experiments",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "introduction": {
      "$ref": "#/$defs/prose"
    },
    "no_experiments_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/prose"
        },
        {
          "type": "null"
        }
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/placement"
      }
    },
    "experiments": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/experiment"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "prose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "labels": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "numericValue": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        }
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "experiment_ids",
        "figures"
      ],
      "properties": {
        "section_id": {
          "$ref": "#/$defs/id"
        },
        "experiment_ids": {
          "$ref": "#/$defs/ids"
        },
        "figures": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "visual_id",
              "alt",
              "explanation"
            ],
            "properties": {
              "visual_id": {
                "$ref": "#/$defs/id"
              },
              "alt": {
                "$ref": "#/$defs/prose"
              },
              "explanation": {
                "$ref": "#/$defs/prose"
              }
            }
          }
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "type",
        "default",
        "domain",
        "unit",
        "explanation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "type": {
          "enum": [
            "number",
            "integer",
            "vector",
            "matrix"
          ]
        },
        "default": {
          "$ref": "#/$defs/numericValue"
        },
        "unit": {
          "type": "string",
          "maxLength": 80
        },
        "explanation": {
          "$ref": "#/$defs/prose"
        },
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "step"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "max": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "unit"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "unit": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "explanation",
        "output_ids",
        "expressions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "explanation": {
          "$ref": "#/$defs/prose"
        },
        "output_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "expressions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 24,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "description": "Bounded expression AST: number, numeric array, $input.id/$output.id reference, or [allowlisted_operation, args...]"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "output_ids",
        "labels"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "scalar",
            "bars",
            "line",
            "scatter",
            "matrix",
            "steps",
            "vector_compare",
            "weight_distribution",
            "weighted_blend",
            "contribution_flow",
            "process"
          ]
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "output_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "row_labels": {
          "$ref": "#/$defs/labels"
        },
        "column_labels": {
          "$ref": "#/$defs/labels"
        },
        "color_domain": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "x_label": {
          "$ref": "#/$defs/label"
        },
        "y_label": {
          "$ref": "#/$defs/label"
        },
        "explanation": {
          "$ref": "#/$defs/prose"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query_input": {
              "$ref": "#/$defs/id"
            },
            "key_input": {
              "$ref": "#/$defs/id"
            },
            "value_input": {
              "$ref": "#/$defs/id"
            },
            "scores_output": {
              "$ref": "#/$defs/id"
            },
            "weights_output": {
              "$ref": "#/$defs/id"
            },
            "result_output": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "section_id",
        "goal",
        "explanation",
        "assumptions",
        "variables",
        "computation",
        "views",
        "challenges"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "section_id": {
          "$ref": "#/$defs/id"
        },
        "goal": {
          "$ref": "#/$defs/prose"
        },
        "explanation": {
          "$ref": "#/$defs/prose"
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/prose"
          }
        },
        "variables": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/variable"
          }
        },
        "computation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outputs",
            "steps"
          ],
          "properties": {
            "outputs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 24,
              "items": {
                "$ref": "#/$defs/output"
              }
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 24,
              "items": {
                "$ref": "#/$defs/step"
              }
            }
          }
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/view"
          }
        },
        "challenges": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "instructions"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "instructions": {
                "$ref": "#/$defs/prose"
              }
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "outcome_id",
        "section_id",
        "level",
        "prompt",
        "options",
        "correct_option_id",
        "expected",
        "tolerance",
        "explanation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "choice",
            "numeric"
          ]
        },
        "outcome_id": {
          "$ref": "#/$defs/id"
        },
        "section_id": {
          "$ref": "#/$defs/id"
        },
        "level": {
          "enum": [
            "remember",
            "understand",
            "apply",
            "analyze",
            "evaluate",
            "create"
          ]
        },
        "prompt": {
          "$ref": "#/$defs/prose"
        },
        "explanation": {
          "$ref": "#/$defs/prose"
        },
        "options": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "$ref": "#/$defs/prose"
              }
            }
          }
        },
        "correct_option_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected": {
          "type": [
            "number",
            "null"
          ]
        },
        "tolerance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        },
        "experiment_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "scenario_inputs": {
          "anyOf": [
            {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 8,
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "$ref": "#/$defs/numericValue"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "output_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
